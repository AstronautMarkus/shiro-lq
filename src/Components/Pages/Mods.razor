@page "/mods"
@inject ModStore Store

<PageTitle>ShiroLQ - Mods</PageTitle>

<div class="page-head">
    <p class="crumbs"><a href="">Inicio</a> / Mods y descargas</p>
    <h1>El arsenal de descargas</h1>
    <p>Los skins, mapas y objetos que ves en mis videos. Todo en un solo lugar.</p>
</div>

<p class="meta">@mods.Count @(mods.Count == 1 ? "archivo" : "archivos")</p>

@foreach (var mod in mods)
{
    <article class="card mod-row">
        <a class="thumb" href="mods/@mod.Id"><img src="@mod.ImageUrl(mod.Thumbnail)" alt="" /></a>
        <div>
            <p class="eyebrow">@mod.Type.Label()</p>
            <h2 class="card-title"><a href="mods/@mod.Id">@mod.Name</a></h2>
            <p class="clamp">@mod.Description</p>
            <a class="btn" href="mods/@mod.Id">Ver mod &rsaquo;</a>
        </div>
    </article>
}

@code {
    private List<Mod> mods = [];

    protected override async Task OnInitializedAsync() => mods = await Store.GetAllAsync();
}
