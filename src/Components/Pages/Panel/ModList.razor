@page "/admin"
@* No prerender: it would show the content, then the skeleton again while the interactive copy reloads. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ModStore Store
@inject IJSRuntime JS
@inject ILogger<ModList> Log

<PageTitle>Admin - Mods</PageTitle>

<div class="admin-head">
    <div>
        <h1>Mods</h1>
        @if (Mods is null)
        {
            <span class="skeleton skeleton-line" style="width: 120px"></span>
        }
        else
        {
            <p class="hint">@Mods.Count @(Mods.Count == 1 ? "mod" : "mods") · @Mods.Count(m => !m.IsPublic) @(Mods.Count(m => !m.IsPublic) == 1 ? "privado" : "privados")</p>
        }
    </div>
    <a class="btn btn-primary" href="admin/mods/new">+ Nuevo mod</a>
</div>

@if (Mods is null)
{
    <div class="panel table-wrap" aria-busy="true">
        <span class="sr-only">Cargando mods...</span>
        <div class="table-tools"><span class="skeleton skeleton-input"></span></div>
        <table class="table" aria-hidden="true">
            <tbody>
                @for (var i = 0; i < 4; i++)
                {
                    <tr>
                        <td><span class="mod-cell"><span class="skeleton table-thumb"></span><span class="skeleton skeleton-line" style="width: 160px"></span></span></td>
                        <td><span class="skeleton skeleton-pill"></span></td>
                        <td><span class="skeleton skeleton-line" style="width: 70px"></span></td>
                        <td><span class="skeleton skeleton-pill"></span></td>
                        <td class="actions"><span class="skeleton skeleton-btn"></span><span class="skeleton skeleton-btn"></span><span class="skeleton skeleton-btn"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Mods.Count == 0)
{
    <div class="panel empty">
        <p>Todavía no hay mods.</p>
        <a class="btn btn-primary" href="admin/mods/new">Subir el primero</a>
    </div>
}
else
{
    <div class="panel table-wrap">
        <div class="table-tools">
            <input type="search" class="search" @bind="search" @bind:event="oninput" placeholder="Buscar por nombre" aria-label="Buscar mods por nombre" />
        </div>
        <table class="table">
            <thead>
                <tr><th>Mod</th><th>Tipo</th><th>Autor</th><th>Visibilidad</th><th><span class="sr-only">Acciones</span></th></tr>
            </thead>
            <tbody>
                @foreach (var mod in Visible)
                {
                    <tr>
                        <td>
                            <a class="mod-cell" href="admin/mods/@mod.Id">
                                <img class="table-thumb" src="@mod.ImageUrl(mod.Thumbnail)" alt="" />
                                <span>@mod.Name</span>
                            </a>
                        </td>
                        <td><span class="pill">@mod.Type.Label()</span></td>
                        <td>@(mod.AuthorName ?? "Cuenta eliminada")</td>
                        <td><span class="pill @(mod.IsPublic ? "pill-public" : "pill-private")">@(mod.IsPublic ? "Público" : "Privado")</span></td>
                        <td class="actions">
                            <a class="btn btn-sm" href="mods/@mod.Id" target="_blank" rel="noopener">Ver</a>
                            <a class="btn btn-sm" href="admin/mods/@mod.Id">Editar</a>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => Delete(mod)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Visible.Any())
        {
            <p class="empty">Ningún mod se llama así.</p>
        }
    </div>
}

<ConfirmDialog @ref="confirm" />

@code {
    private List<Mod>? Mods { get; set; }

    private string search = "";
    private ConfirmDialog confirm = default!;

    private IEnumerable<Mod> Visible => Mods!.Where(m => m.Name.Contains(search.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync() => Mods = await Store.GetAllAsync(includePrivate: true);

    private async Task Delete(Mod mod)
    {
        if (!await confirm.AskAsync($"¿Eliminar \"{mod.Name}\"?", "Se borran el mod, su archivo y todas sus fotos. No se puede deshacer.", "Eliminar mod")) return;
        try
        {
            await Store.DeleteAsync(mod.Id);
        }
        catch (Exception e)
        {
            Log.LogError(e, "Deleting mod {Id} failed", mod.Id);
            await Toast("No se pudo eliminar el mod. Inténtalo de nuevo.", "error");
            return;
        }
        Mods!.Remove(mod);
        await Toast($"\"{mod.Name}\" eliminado.");
    }

    private ValueTask Toast(string message, string kind = "success") => JS.InvokeVoidAsync("adminUi.toast", message, kind);
}
