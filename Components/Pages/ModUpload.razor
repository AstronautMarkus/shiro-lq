@page "/mods/upload"
@rendermode InteractiveServer
@inject ModStore Store
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

<PageTitle>ShiroLQ - Subir mod</PageTitle>

@* There's no login yet, so uploading only exists when running in Development. *@
@if (Env.IsDevelopment())
{
    <section class="box">
        <h1>Subir mod</h1>
        <div class="box-body">
            <EditForm Model="mod" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <p><label>Nombre<br /><InputText @bind-Value="mod.Name" placeholder="Ej: Isla Norte" /></label></p>
                <ValidationMessage For="() => mod.Name" />
                <p><label>Descripción<br /><InputTextArea @bind-Value="mod.Description" rows="5" cols="50" placeholder="Qué incluye el mod y cómo instalarlo" /></label></p>
                <ValidationMessage For="() => mod.Description" />
                <p>
                    <label>
                        Tipo<br />
                        <InputSelect @bind-Value="mod.Type">
                            @foreach (var type in Enum.GetValues<ModType>())
                            {
                                <option value="@type">@type.Label()</option>
                            }
                        </InputSelect>
                    </label>
                </p>
                <p><label>Archivo del mod (máx. 500 MB)<br /><InputFile OnChange="e => file = e.File" /></label></p>
                <p><label>Miniatura (obligatoria, máx. 10 MB)<br /><InputFile OnChange="e => thumbnail = e.File" accept="@imageAccept" /></label></p>
                <p><label>Fotos (opcional, hasta @ModStore.MaxImages, máx. 10 MB c/u)<br /><InputFile OnChange="e => images = e.GetMultipleFiles(int.MaxValue)" accept="@imageAccept" multiple /></label></p>
                @if (error is not null)
                {
                    <p class="validation-message">@error</p>
                }
                <button class="btn" type="submit" disabled="@saving">@(saving ? "Subiendo..." : "Subir")</button>
            </EditForm>
        </div>
    </section>
}

@code {
    private static readonly string imageAccept = string.Join(',', ModStore.ImageExtensions);

    private readonly Mod mod = new();
    private IBrowserFile? file;
    private IBrowserFile? thumbnail;
    private IReadOnlyList<IBrowserFile> images = [];
    private string? error;
    private bool saving;

    protected override void OnInitialized()
    {
        if (!Env.IsDevelopment()) Nav.NotFound();
    }

    private async Task Save()
    {
        error = Validate();
        if (error is not null) return;

        saving = true;
        await Store.AddAsync(mod, file!, thumbnail!, images);
        Nav.NavigateTo($"mods/{mod.Id}");
    }

    private string? Validate()
    {
        if (file is null) return "Elige el archivo del mod.";
        if (file.Size > ModStore.MaxFileSize) return "El archivo del mod pesa más de 500 MB.";
        if (thumbnail is null) return "Elige una miniatura.";
        if (images.Count > ModStore.MaxImages) return $"Máximo {ModStore.MaxImages} fotos.";
        foreach (var image in images.Prepend(thumbnail))
        {
            if (!ModStore.IsImage(image.Name)) return $"{image.Name} no es una imagen ({imageAccept}).";
            if (image.Size > ModStore.MaxImageSize) return $"{image.Name} pesa más de 10 MB.";
        }
        return null;
    }
}
