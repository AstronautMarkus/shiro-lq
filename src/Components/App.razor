<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Roboto+Condensed:wght@400;700&display=swap" />
    <link rel="stylesheet" href="@Assets[IsAdmin ? "admin.css" : "app.css"]" />
    <link rel="stylesheet" href="@Assets["shiro-lq.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @if (IsAdmin)
    {
        <script src="@Assets["admin.js"]"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // The admin panel has its own look and doesn't load the public site's stylesheet.
    private bool IsAdmin => HttpContext.Request.Path.StartsWithSegments("/admin");
}
