@page "/mods/{Id:int}"
@inject ModStore Store
@inject NavigationManager Nav

@if (mod is not null)
{
    <PageTitle>ShiroLQ - @mod.Name</PageTitle>

    <section class="box">
        <h1>@mod.Name</h1>
        <div class="box-body">
            <p><a href="mods">&laquo; Volver a Mods</a></p>
            <div class="mod-detail">
                <div class="thumb"></div>
                <div class="mod-info">
                    <table class="specs">
                        <tr><th scope="row">Tipo</th><td>@mod.Type.Label()</td></tr>
                    </table>
                    <p>@mod.Description</p>
                    @* download attribute keeps Blazor's enhanced navigation from fetching the file twice *@
                    <a class="btn btn-lg" href="mods/@mod.Id/download" download>Descargar</a>
                    <p class="muted">Lee el archivo LEEME.txt antes de instalar.</p>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private Mod? mod;

    protected override async Task OnParametersSetAsync()
    {
        mod = await Store.GetAsync(Id);
        if (mod is null) Nav.NotFound();
    }
}
