# Copy to /etc/shiro-lq.env (root, chmod 600). Same keys as the user-secrets, with __ instead of :.
# Values with ; go in double quotes. Avoid " and \ in passwords: systemd treats them as quoting/escapes.
ConnectionStrings__Default="Server=localhost;Port=3306;Database=shiro_lq;User ID=shiro;Password=tu_contraseña"

# S3 or Local. With Local, files go to /var/www/shiro-lq/uploads (see README).
Storage__Provider=S3
Storage__S3__Bucket=nombre-del-bucket
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=AKIA...
Storage__S3__SecretKey=...

# First start only: creates the first admin if the admins table is empty. Delete these lines afterwards.
Admin__Name=Shiro
Admin__Username=shiro
Admin__Email=shiro@ejemplo.com
Admin__Password=una-contraseña-larga
