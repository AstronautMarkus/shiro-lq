@page "/admin/admins/new"
@page "/admin/admins/{Id:int}"
@rendermode InteractiveServer
@inject AdminStore Admins
@inject NavigationManager Nav

<PageTitle>Admin - @(IsNew ? "Nuevo admin" : "Editar admin")</PageTitle>

@if (admin is not null)
{
    <div class="admin-head">
        <h1>@(IsNew ? "Nuevo admin" : "Editar admin")</h1>
    </div>

    <div class="panel">
        <EditForm Model="admin" OnValidSubmit="Save" class="form">
            <DataAnnotationsValidator />
            <label class="field">Nombre<InputText @bind-Value="admin.Name" placeholder="Ej: Shiro" /></label>
            <ValidationMessage For="() => admin.Name" />
            <label class="field">Usuario<InputText @bind-Value="admin.Username" autocomplete="off" placeholder="Ej: shiro (para iniciar sesión)" /></label>
            <ValidationMessage For="() => admin.Username" />
            <label class="field">Email<InputText type="email" @bind-Value="admin.Email" placeholder="Ej: shiro@ejemplo.com" /></label>
            <ValidationMessage For="() => admin.Email" />
            <label class="field">
                Contraseña
                <InputText type="password" @bind-Value="admin.Password" autocomplete="new-password"
                           placeholder="@(IsNew ? "Mínimo 8 caracteres" : "Déjala vacía para no cambiarla")" />
            </label>
            <ValidationMessage For="() => admin.Password" />

            @if (error is not null)
            {
                <p class="alert">@error</p>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@saving">@(saving ? "Guardando..." : "Guardar")</button>
                <a class="btn" href="admin/admins">Cancelar</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private Admin? admin;
    private string? error;
    private bool saving;

    protected override async Task OnParametersSetAsync()
    {
        admin = IsNew ? new() : await Admins.GetAsync(Id!.Value);
        if (admin is null) Nav.NotFound();
    }

    private async Task Save()
    {
        if (IsNew && string.IsNullOrEmpty(admin!.Password))
        {
            error = "La contraseña es obligatoria.";
            return;
        }

        saving = true;
        var saved = await Admins.SaveAsync(admin!);
        saving = false;
        if (saved) Nav.NavigateTo("admin/admins");
        else error = "Ese usuario o email ya lo usa otro admin.";
    }
}
