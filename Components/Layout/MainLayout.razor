@inherits LayoutComponentBase

<div class="site">
    <div class="topbar">Loquendo &middot; GTA &middot; Modding</div>

    <header class="hero">
        <a class="logo" href="">Shiro <span>LQ</span></a>
        <p class="hero-tagline">Videos Loquendo &middot; Mods &middot; Descargas</p>
        <p class="hero-sub">Videos, historias y mods desde el otro lado.</p>
        <span class="hero-badge">&#10022; Sitio oficial del canal</span>
    </header>

    <NavMenu />

    <div class="ticker">
        <b>Última hora</b>
        <p>Videos Loquendo nuevos cada semana &middot; Descarga los últimos mods en la sección Mods</p>
        <span>Bienvenido, visitante</span>
    </div>

    <div class="columns">
        <main class="content">
            @Body
        </main>

        <aside class="sidebar">
            <section class="box">
                <h2>El rincón de Shiro</h2>
                <div class="box-body">
                    <p class="display">Bienvenido al canal.</p>
                    <p class="accent">Videos Loquendo, parodias y más.</p>
                    <p>¡Suscríbete para no perderte nada!</p>
                    <a class="btn btn-block" href="@YouTubeUrl" target="_blank" rel="noopener">&#9654; Suscribirme al canal</a>
                </div>
            </section>

            <section class="box">
                <h2>Explora el sitio</h2>
                <div class="box-body">
                    <ul class="links">
                        <li><a href="videos">Videos Loquendo</a></li>
                        <li><a href="mods">Mods y skins</a></li>
                    </ul>
                </div>
            </section>
        </aside>
    </div>

    <footer class="footer">
        <div>
            <p class="footer-logo">Shiro LQ</p>
            <p>Videos con voz. Mods con estilo.</p>
        </div>
        <div>
            <p><a href="">Inicio</a> / <a href="videos">Videos</a> / <a href="mods">Mods</a></p>
            <p>&copy; @DateTime.Now.Year Shiro LQ &middot; Hecho para verse a 1024 &times; 768</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // TODO: replace # with the channel URL (used here and in NavMenu).
    public const string YouTubeUrl = "#";
}
