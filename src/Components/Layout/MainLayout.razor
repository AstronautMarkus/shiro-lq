@inherits LayoutComponentBase
@inject ChannelStore Channels
@inject VideoStore Videos
@inject ILogger<MainLayout> Log

<div class="site">
    <div class="topbar">Hello, world!</div>

    <header class="hero">
        <a class="logo" href="">Shiro <span>LQ</span></a>
        <p class="hero-tagline">Desarrollador de software y modder de GTA:SA</p>
        <p class="hero-sub">Bienvenidos al sitio web de Shiro LQ, donde podrás encontrar todos los Programas, Mods y Skins (Personajes) que uso en mis Videos.</p>
        <img class="hero-art" src="img/walfa-ichirin.png" alt="" width="105" height="159" />
    </header>

    <NavMenu YouTubeUrl="@main?.Url" />

    <div class="ticker">
        <b>Última hora</b>
        @if (latest is not null)
        {
            <p>@(latest.PublishedAt > DateTime.UtcNow.AddDays(-7) ? "Nuevo video en el canal" : "Último video"): <a href="@latest.Url" target="_blank" rel="noopener">@latest.Title</a></p>
        }
        else
        {
            <p>Entérate de los últimos mods y videos en este sitio</p>
        }
        <span>Bienvenido, visitante</span>
    </div>

    <div class="columns">
        <main class="content">
            @Body
        </main>

        <aside class="sidebar">
            <section class="box">
                <h2>Canal de Youtube</h2>
                <div class="box-body">
                    <img class="pfp" src="img/pfp.png" alt="Foto de perfil de Shiro LQ" width="96" height="96" />
                    <p class="display">Bienvenido al canal.</p>
                    <p class="accent">Videos Loquendo, parodias y más.</p>
                    <p>¡Suscríbete para no perderte nada!</p>
                    @if (main is not null)
                    {
                        <a class="btn btn-block" href="@main.Url" target="_blank" rel="noopener">&#9654; Suscribirme al canal</a>
                    }
                </div>
            </section>

            <section class="box">
                <h2>Explora el sitio</h2>
                <div class="box-body">
                    <ul class="links">
                        <li><a href="videos">Videos Loquendo</a></li>
                        <li><a href="mods">Mods y skins</a></li>
                    </ul>
                </div>
            </section>
        </aside>
    </div>

    <footer class="footer">
        <div>
            <p class="footer-logo">Shiro LQ</p>
            <p>Conocido por muchos nombres en el pasado.</p>
            <p>Solo soy yo, la tormenta que se acerca.</p>
        </div>
        <div>
            <p><a href="">Inicio</a> / <a href="videos">Videos</a> / <a href="mods">Mods</a></p>
            <p>&copy; @DateTime.Now.Year Shiro LQ &middot; Hecho para verse a 1024 &times; 768</p>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private Channel? main;
    // The main channel's newest video, for the ticker.
    private Video? latest;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            main = await Channels.GetMainAsync();
            latest = main is null ? null : (await Videos.GetLatestAsync(main.Id, 1)).FirstOrDefault();
        }
        catch (Exception e)
        {
            // The error page uses this layout too: it still renders, just without the channel links.
            Log.LogError(e, "Loading the main channel failed");
        }
    }
}
