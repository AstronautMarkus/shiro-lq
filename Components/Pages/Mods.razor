@page "/mods"
@inject ModStore Store
@inject IWebHostEnvironment Env

<PageTitle>ShiroLQ - Mods</PageTitle>

<section class="box">
    <h1>Mods</h1>
    <div class="box-body">
        <p>Descarga los mods del canal. Haz clic en uno para ver los detalles.</p>
        @if (Env.IsDevelopment())
        {
            <p><a class="btn" href="mods/upload">Subir mod</a></p>
        }
        @if (mods.Count == 0)
        {
            <p class="muted">Aún no hay mods.</p>
        }
        <div class="grid">
            @foreach (var mod in mods)
            {
                <a class="mod-card" href="mods/@mod.Id">
                    <div class="thumb"></div>
                    <p>@mod.Name</p>
                    <span class="muted">@mod.Type.Label()</span>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private List<Mod> mods = [];

    protected override async Task OnInitializedAsync() => mods = await Store.GetAllAsync();
}
