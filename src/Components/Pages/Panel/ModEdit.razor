@page "/admin/mods/new"
@page "/admin/mods/{Id:guid}"
@rendermode InteractiveServer
@inject ModStore Store
@inject NavigationManager Nav

<PageTitle>Admin - @(IsNew ? "Nuevo mod" : "Editar mod")</PageTitle>

@if (mod is not null)
{
    <div class="admin-head">
        <h1>@(IsNew ? "Nuevo mod" : "Editar mod")</h1>
    </div>

    <div class="panel">
        <EditForm Model="mod" OnValidSubmit="Save" class="form">
            <DataAnnotationsValidator />
            <label class="field">Nombre<InputText @bind-Value="mod.Name" placeholder="Ej: Isla Norte" /></label>
            <ValidationMessage For="() => mod.Name" />
            <label class="field">Descripción<InputTextArea @bind-Value="mod.Description" rows="6" placeholder="Qué incluye el mod y cómo instalarlo" /></label>
            <ValidationMessage For="() => mod.Description" />
            <label class="field">
                Tipo (elige uno)
                <InputSelect @bind-Value="mod.Type">
                    @foreach (var type in Enum.GetValues<ModType>())
                    {
                        <option value="@type">@type.Label()</option>
                    }
                </InputSelect>
            </label>

            <label class="field">
                Archivo del mod (@(IsNew ? "obligatorio" : "opcional, reemplaza el actual"), máx. 500 MB)
                <InputFile OnChange="e => file = e.File" />
            </label>

            <label class="field">
                Miniatura (@(IsNew ? "obligatoria" : "opcional, reemplaza la actual"), máx. 10 MB)
                <InputFile OnChange="e => thumbnail = e.File" accept="@imageAccept" />
            </label>
            @if (!IsNew)
            {
                <div class="preview"><img src="@mod.ImageUrl(mod.Thumbnail)" alt="Miniatura actual" /></div>
            }

            <label class="field">
                Fotos (opcional, hasta @ModStore.MaxImages, máx. 10 MB c/u@(IsNew ? "" : "; si eliges fotos nuevas reemplazan todas las actuales"))
                <InputFile OnChange="e => images = e.GetMultipleFiles(int.MaxValue)" accept="@imageAccept" multiple />
            </label>
            @if (!IsNew && mod.Images.Count > 0)
            {
                <div class="preview">
                    @foreach (var image in mod.Images)
                    {
                        <img src="@mod.ImageUrl(image)" alt="Foto actual" />
                    }
                </div>
            }

            @if (error is not null)
            {
                <p class="alert">@error</p>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit" disabled="@saving">@(saving ? "Guardando..." : "Guardar")</button>
                <a class="btn" href="admin">Cancelar</a>
            </div>
        </EditForm>
    </div>
}

@code {
    private static readonly string imageAccept = string.Join(',', ModStore.ImageExtensions);

    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id is null;
    private Mod? mod;
    private IBrowserFile? file;
    private IBrowserFile? thumbnail;
    private IReadOnlyList<IBrowserFile> images = [];
    private string? error;
    private bool saving;

    protected override async Task OnParametersSetAsync()
    {
        mod = IsNew ? new() : await Store.GetAsync(Id!.Value);
        if (mod is null) Nav.NotFound();
    }

    private async Task Save()
    {
        error = Validate();
        if (error is not null) return;

        saving = true;
        await Store.SaveAsync(mod!, file, thumbnail, images);
        Nav.NavigateTo("admin");
    }

    private string? Validate()
    {
        if (IsNew && file is null) return "Elige el archivo del mod.";
        if (file?.Size > ModStore.MaxFileSize) return "El archivo del mod pesa más de 500 MB.";
        if (IsNew && thumbnail is null) return "Elige una miniatura.";
        if (images.Count > ModStore.MaxImages) return $"Máximo {ModStore.MaxImages} fotos.";
        foreach (var image in images.Prepend(thumbnail).OfType<IBrowserFile>())
        {
            if (!ModStore.IsImage(image.Name)) return $"{image.Name} no es una imagen ({imageAccept}).";
            if (image.Size > ModStore.MaxImageSize) return $"{image.Name} pesa más de 10 MB.";
        }
        return null;
    }
}
