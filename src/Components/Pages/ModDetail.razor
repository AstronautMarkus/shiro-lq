@page "/mods/{Id:guid}"
@inject ModStore Store
@inject NavigationManager Nav

@if (mod is not null)
{
    var ext = Path.GetExtension(mod.FileName).TrimStart('.').ToUpperInvariant();

    <PageTitle>ShiroLQ - @mod.Name</PageTitle>

    <div class="page-head">
        <p class="crumbs"><a href="">Inicio</a> / <a href="mods">Mods y descargas</a> / @mod.Name</p>
        <h1>@mod.Name</h1>
        <p class="eyebrow">@mod.Type.Label()</p>
    </div>

    <div class="thumb shot">
        <span class="tag">Captura dentro del juego</span>
        <img src="@mod.ImageUrl(mod.Thumbnail)" alt="Miniatura de @mod.Name" />
    </div>

    <section class="box">
        <h2>Descargar archivo</h2>
        <div class="box-body">
            @* download attribute keeps Blazor's enhanced navigation from fetching the file twice *@
            <a class="btn btn-lg" href="mods/@mod.Id/download" download>&darr; Descargar @mod.Name</a>
            <p class="meta">@mod.Type.Label()@(ext == "" ? "" : " · " + ext)</p>
            <p class="muted">Lee la descripción antes de instalar. Guarda una copia de los archivos originales.</p>
        </div>
    </section>

    <section class="box">
        <h2>Acerca del mod</h2>
        <div class="box-body">
            <p class="description">@mod.Description</p>
        </div>
    </section>

    @if (mod.Images.Count > 0)
    {
        <section class="box">
            <h2>Fotos</h2>
            <div class="box-body">
                <div class="grid">
                    @for (var i = 0; i < mod.Images.Count; i++)
                    {
                        <a class="thumb" href="@mod.ImageUrl(mod.Images[i])" target="_blank"><img src="@mod.ImageUrl(mod.Images[i])" alt="Foto @(i + 1) de @mod.Name" /></a>
                    }
                </div>
            </div>
        </section>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Mod? mod;

    protected override async Task OnParametersSetAsync()
    {
        mod = await Store.GetAsync(Id);
        if (mod is null) Nav.NotFound();
    }
}
