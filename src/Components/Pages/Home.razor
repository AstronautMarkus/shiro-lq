@page "/"
@attribute [StreamRendering]
@inject ModStore Store
@inject ChannelStore Channels
@inject VideoStore Videos

<PageTitle>ShiroLQ - Inicio</PageTitle>

<div class="page-head">
    <h1>Bienvenido a mi pequeño caos</h1>
    <p>Videos Loquendo, GTA y una buena dosis de estilo.</p>
</div>

<section class="box">
    <h2>&#9654; Último video / Estreno en el canal</h2>
    <div class="box-body">
        @if (videos is null)
        {
            @* Streamed first: shown while the videos load. *@
            <div aria-busy="true">
                <span class="sr-only">Cargando videos...</span>
                <div class="video skeleton" aria-hidden="true"></div>
                <span class="skeleton skeleton-line skeleton-title" aria-hidden="true"></span>
            </div>
        }
        else if (videos.Count == 0)
        {
            <p class="muted">Aún no hay videos.</p>
        }
        else
        {
            var latest = videos[0];
            <div class="video">
                <iframe src="@latest.EmbedUrl" title="@latest.Title" referrerpolicy="strict-origin-when-cross-origin"
                        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
            </div>
            <p class="card-title">@latest.Title</p>
            <p class="meta">Subido el @latest.Date</p>
        }
    </div>
</section>

@if (videos is null || videos.Count > 1)
{
    <section class="box">
        <h2>Más videos del canal <a href="videos">Ver videoteca &rsaquo;</a></h2>
        <div class="box-body">
            <div class="grid">
                @if (videos is null)
                {
                    @for (var i = 0; i < 3; i++)
                    {
                        <div aria-hidden="true">
                            <div class="video skeleton"></div>
                            <span class="skeleton skeleton-line skeleton-title"></span>
                        </div>
                    }
                }
                @foreach (var video in videos?.Skip(1) ?? [])
                {
                    <div>
                        <a class="video" href="@video.Url" target="_blank" rel="noopener"><img src="@video.ThumbnailUrl" alt="" loading="lazy" /></a>
                        <p class="card-title"><a href="@video.Url" target="_blank" rel="noopener">@video.Title</a></p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="box">
    <h2>Mods recién salidos del horno <a href="mods">Todas las descargas &rsaquo;</a></h2>
    <div class="box-body">
        @if (mods is null)
        {
            @* Streamed first: shown while the mods load. *@
            <div class="grid grid-2" aria-busy="true">
                <span class="sr-only">Cargando mods...</span>
                @for (var i = 0; i < 2; i++)
                {
                    <div class="mod-mini" aria-hidden="true">
                        <div class="thumb skeleton"></div>
                        <div>
                            <span class="skeleton skeleton-line" style="width: 50px"></span>
                            <span class="skeleton skeleton-line skeleton-title"></span>
                        </div>
                        <span class="skeleton skeleton-btn"></span>
                    </div>
                }
            </div>
        }
        else if (mods.Count == 0)
        {
            <p class="muted">Aún no hay mods.</p>
        }
        <div class="grid grid-2">
            @foreach (var mod in mods?.Take(4) ?? [])
            {
                <div class="mod-mini">
                    <a class="thumb" href="mods/@mod.Id"><img src="@mod.ImageUrl(mod.Thumbnail)" alt="" /></a>
                    <div>
                        <p class="eyebrow">@mod.Type.Label()</p>
                        <a class="card-title" href="mods/@mod.Id">@mod.Name</a>
                    </div>
                    @* download attribute keeps Blazor's enhanced navigation from fetching the file twice *@
                    <a class="btn btn-block" href="mods/@mod.Id/download" download>&darr; Descargar</a>
                </div>
            }
        </div>
    </div>
</section>

<section class="box">
    <h2>Detrás de la voz</h2>
    <div class="box-body">
        <p class="display">Aquí el Loquendo sigue vivo.</p>
        <p>Aquí encontrarás todos los videos Loquendo del canal y los mods para descargar. Pasa, ponte cómodo y no olvides suscribirte.</p>
    </div>
</section>

@code {
    private List<Mod>? mods;
    // The main channel's newest 4: the first one is played on the page, the rest are linked.
    private List<Video>? videos;

    protected override async Task OnInitializedAsync()
    {
        var main = await Channels.GetMainAsync();
        videos = main is null ? [] : await Videos.GetLatestAsync(main.Id, 4);
        mods = await Store.GetAllAsync(includePrivate: false);
    }
}
